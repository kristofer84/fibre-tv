<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="net.xcds.iptv"
    android:versionCode="3"
    android:versionName="1.2">

    <!-- Multicast: the stream is joined from this device, over WiFi, so the app
         needs the multicast lock permission or the group is never delivered. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.INTERNET"/>

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34"/>

    <!-- leanback is no longer required, so the same apk can be installed on a phone or
         tablet from Play as well as side-loaded. A TV still installs it: the launcher
         filter below gives it LEANBACK_LAUNCHER, and touchscreen is not required, so
         neither a TV nor a phone is excluded. The app is usable on both now that the
         picture can be tapped to reach the controls. -->
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <activity
            android:name="net.xcds.iptv.TvActivity"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <!-- Two filters, not one with both categories: the TV launcher looks
                 for LEANBACK_LAUNCHER and aapt/Play report the app as a leanback
                 app only when they come from their own filter. LAUNCHER is kept
                 so the same apk can be side-loaded onto a phone for testing. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
