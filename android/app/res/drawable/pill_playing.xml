<?xml version="1.0" encoding="utf-8"?>
<!-- Playing: a quiet fill of its own, so "what am I watching" survives focus moving away. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/pill_playing"/>
    <corners android:radius="@dimen/pill_radius"/>
    <stroke android:width="1dp" android:color="@color/accent_soft"/>
</shape>
