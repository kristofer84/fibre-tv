<?xml version="1.0" encoding="utf-8"?>
<!-- A gradient instead of a hard-edged panel: dark under the rows, transparent above them. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="@color/scrim_bottom"
        android:endColor="@color/scrim_top"/>
</shape>
